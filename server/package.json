{
  "name": "@beriru/kfc",
  "version": "0.1.4",
  "description": "CLI and MCP bridge for using JEB static analysis from AI agents",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/konata/Kfc.git"
  },
  "homepage": "https://github.com/konata/Kfc#readme",
  "bugs": {
    "url": "https://github.com/konata/Kfc/issues"
  },
  "type": "module",
  "main": "src/index.ts",
  "bin": {
    "kfc": "src/cli.ts"
  },
  "files": [
    "README.md",
    "src",
    "scripts",
    "jeb"
  ],
  "scripts": {
    "kfc": "bun src/cli.ts",
    "start": "bun src/index.ts",
    "mcp": "bun src/cli.ts mcp",
    "build:jeb": "cd .. && ./gradlew :extension:shadowJar",
    "stage:jeb": "bun scripts/stage-jeb.ts",
    "prepack": "bun run build:jeb && bun run stage:jeb",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "fast-xml-parser": "^5.2.5",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "typescript": "^5.9.2"
  }
}
